[Unit]
Description=Bluetooth volume guard (clamps 100% -> 60%)
Documentation=man:airpods-volume-guard.sh
After=pipewire.service pipewire-session-manager.service sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=%h/.local/bin/airpods-volume-guard.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target