[Unit]
Description=Waybar smart-hide daemon (cursor-zone based)
Documentation=file:///home/spix/.config/waybar/smart-hide.sh
After=default.target waybar.service

[Service]
Type=simple
ExecStart=/home/spix/.config/waybar/smart-hide.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=default.target
